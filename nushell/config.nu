def --env cx [arg] {
    cd $arg
    ls -l
}

alias l = ls --all
alias c = clear
alias ll = ls -l
alias lt = eza --tree --level=2 --long --icons --git
alias v = nvim
alias as = aerospace
alias asr = atuin scripts run

def ff [] {
    aerospace list-windows --all | fzf --bind 'enter:execute(bash -c "aerospace focus --window-id {1}")+abort'
}

# Git
alias gc = git commit -m
alias gca = git commit -a -m
alias gp = git push origin HEAD
alias gpu = git pull origin
alias gst = git status
alias glog = git log --graph --topo-order --pretty='%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N' --abbrev-commit
alias gdiff = git diff
alias gco = git checkout
alias gb = git branch
alias gba = git branch -a
alias gadd = git add
alias ga = git add -p
alias gcoall = git checkout -- .
alias gr = git remote
alias gre = git reset

# K8s
alias k = kubectl
alias ka = kubectl apply -f
alias kg = kubectl get
alias kd = kubectl describe
alias kdel = kubectl delete
alias kl = kubectl logs
alias kgpo = kubectl get pod
alias kgd = kubectl get deployments
alias kc = kubectx
alias kns = kubens
alias kl = kubectl logs -f
alias ke = kubectl exec -it


# Choose starship config based on terminal capabilities (set before init)
let _starship_config = ($home | path join '.config' 'starship' 'starship.toml')
$env.STARSHIP_CONFIG = $_starship_config

# Nushell loads vendor autoload files after this config. Keep only our generated
# cache, and remove a previously generated cache if Starship has been removed.
if $nu.is-interactive {
    let starship_cache = ($nu.data-dir | path join 'vendor' 'autoload' 'starship.nu')
    if (which starship | where type == 'external' | is-empty) {
        if ($starship_cache | path exists) {
            let previous = (try { open --raw $starship_cache } catch { '' })
            let kind = (try { ls -l $starship_cache | get 0.type } catch { '' })
            if $kind == 'file' and (($previous | str starts-with '# dotfiles executable: ') or ($previous | str starts-with '# this file is both a valid')) {
                rm --force $starship_cache
            }
        }
    } else if (which dotfiles-refresh-nu-init | where type == 'custom' | is-not-empty) {
        dotfiles-refresh-nu-init 'starship' $starship_cache
    }
}
