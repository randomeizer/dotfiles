# Only these top-level configuration directories are deployed by `stow .`.
# Add new config directories deliberately; everything else is repository-only.
^/(?!(?:aerospace|agents|atuin|ghostty|hammerspoon|karabiner|nushell|nvim|powershell|scripts|sketchybar|skhd|ssh|starship|tmux|wezterm|zellij|zshrc)(?:/|$)).*

# A local ignore file replaces Stow's default list. Keep nested metadata and
# generated Python files out of the installed configuration too.
\.git
\.gitignore
\.DS_Store
__pycache__
.*\.py[co]
